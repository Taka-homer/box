# このファイルを .env.local にコピーして値を設定し、サーバーを再起動してください。
# どれも未設定なら、データはこの端末のブラウザに保存され、通常検索だけで動作します。

# ---- 家族共有（Supabase）----
# 設定すると、招待した家族とデータを共有するモードになります。
# Supabase の Project Settings → API（Data API）にある値を入れます。
# どちらも「ブラウザに公開してよい値」です。service_role キー（秘密のキー）は絶対に入れないでください。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- AI検索（任意・有料）----
# ここに書いた値はサーバー側だけで使われ、ブラウザには送られません。
AI_SEARCH_PROVIDER=
ANTHROPIC_API_KEY=
AI_SEARCH_MODEL=
