# AI検索の設定（任意）。未設定でも通常検索だけでアプリは動作します。
# このファイルを .env.local にコピーして値を設定し、サーバーを再起動してください。
# ここに書いた値はサーバー側だけで使われ、ブラウザには送られません。

# AI検索を有効にする（現在対応しているのは anthropic のみ）
AI_SEARCH_PROVIDER=

# Anthropic の API キー（https://platform.claude.com で発行。利用料金が発生します）
ANTHROPIC_API_KEY=

# 使用するモデル（省略時は claude-opus-5-5）
AI_SEARCH_MODEL=
